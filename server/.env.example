# ---- Required ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/univault
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Optional ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=7d

# ---- Image storage (MongoDB) — replaces Cloudinary ----
# Images are stored in a separate database. By default that is a second
# database ("univault_media") on the same cluster as MONGO_URI, so nothing
# else needs to be set up.
MEDIA_DB_NAME=univault_media
# Optional: keep images on a completely separate cluster (e.g. a second free
# Atlas cluster). Leave empty to use the same cluster as MONGO_URI.
MEDIA_MONGO_URI=
# Uploads are refused once stored images reach this size. Atlas free tier
# (M0) has 512 MB in total — keep this comfortably below it.
MEDIA_STORAGE_LIMIT_MB=400

# ---- Teacher account (optional) ----
# If both are set, `npm run seed` (and server start, if it seeds) creates/updates
# a user with the "teacher" role. Teachers can create, view and edit projects,
# but can never delete them.
TEACHER_EMAIL=
TEACHER_PASSWORD=
